# ==========================================
# Enterprise Omnichannel AI Support Hub
# Global Environment Variables Template
# ==========================================

# Database Configurations (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
DB_DSN=host=localhost user=postgres password=postgres dbname=postgres port=5432 sslmode=disable TimeZone=UTC

# Redis Configuration (Cache & Rate Limiting)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Kafka Message Broker (KRaft Mode)
KAFKA_BROKERS=localhost:9092
KAFKA_ORDER_TOPIC=order-events
KAFKA_DLQ_TOPIC=order-dlq
KAFKA_USER_GROUP=user-service-group
KAFKA_CONSUMER_GROUP=inventory-service-group

# Service Addresses & Ports
PORT=8080
USER_SERVICE_ADDR=localhost:50051
ORDER_SERVICE_ADDR=localhost:50052

# Security & Authentication
JWT_SECRET=supersecret-enterprise-jwt-key-change-in-production

# AI Engine & LLM Providers (services/ai)
# Option A: Cloud Providers
OPENAI_API_KEY=your-openai-api-key-here
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# Option B: Local Ollama (fallback when no API key provided)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
SEMANTIC_CACHE_THRESHOLD=0.85

# Notification SMTP Settings (services/notification)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@enterprise.ai

